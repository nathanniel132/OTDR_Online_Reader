# ===================================================
# OTDR Online Reader - Environment Variables for Vercel
# Copy-paste nilai di bawah ke Dashboard Vercel:
# Settings -> Environment Variables
# ===================================================

APP_NAME="OTDR Online Reader"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://otdr-online-reader.vercel.app

# Generated Application Key (wajib untuk enkripsi session & cookie)
APP_KEY=base64:4G/Ncegn6lpdrWvhNM439t5m4xvqRlc6Z6LrllDsWVQ=

# Logging: kirim log langsung ke Vercel Function logs console
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Session & Cache: Stateless / Serverless safe (tanpa database/disk)
CACHE_STORE=array
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Cache & Compiled Views redirect ke folder writeable Vercel (/tmp)
VIEW_COMPILED_PATH=/tmp/views
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
